ARG BASE_IMAGE=adt-base:latest

# ==============================================================================
# Stage 1: dbt-core inherited from the shared adt-base image (Python 3.12 + uv)
# ==============================================================================
FROM ${BASE_IMAGE} AS dbt-core

ARG DBT_CORE_VERSION=">=1.8,<2.0"

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    DBT_PROFILES_DIR=/app/dbt \
    DBT_PROJECT_DIR=/app/dbt

WORKDIR /app

# Install dbt-core using uv (uv and system compilation tools already present from base)
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -d "$VIRTUAL_ENV" ]; then \
        uv pip install "dbt-core${DBT_CORE_VERSION}"; \
    else \
        uv pip install --system "dbt-core${DBT_CORE_VERSION}"; \
    fi

# ==============================================================================
# Stage 2: Dynamic adapter installation (matches target: dbt-third-party in Compose)
# ==============================================================================
FROM dbt-core AS dbt-third-party

ARG dbt_third_party="dbt-duckdb"

RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "$dbt_third_party" ]; then \
        if [ -d "$VIRTUAL_ENV" ]; then \
            uv pip install "$dbt_third_party"; \
        else \
            uv pip install --system "$dbt_third_party"; \
        fi \
    fi

ENTRYPOINT ["dbt"]
CMD ["--help"]
